{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "webar",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--host", "0.0.0.0", "--port", "5001", "--reload"],
      "port": 5001
